    "https://*.perfumebox.com/*",
    "https://beautyhouse.com/*",
    "https://*.beautyhouse.com/*",
    "https://emntscents.com/*",
    "https://*.emntscents.com/*",
    "https://aurafragrance.com/*",
    "https://*.aurafragrance.com/*",
    "https://microperfumes.com/*",
